        prev = nullptr;
    }
};*/

class Solution {
  public:
    Node* deleteAllOccurOfX(Node* head, int x) {
        
        Node* temp = head;
        while(temp != NULL){
            
            if(temp -> data == x){
                if(temp == head){
                    head = head -> next;
                }
                
                Node* nextNode = temp -> next;
                Node* prevNode = temp -> prev;
                
                if(nextNode != NULL) nextNode -> prev = prevNode;
                if(prevNode != NULL) prevNode -> next = nextNode;
                
                free(temp);
                
                temp = nextNode;
            }
            
            else temp = temp -> next;
        }
        return head;
        
        
    }
};
